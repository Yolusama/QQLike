<Window x:Class="QQLike.Components.UserContactGroupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QQLike.Components"
        WindowStartupLocation="CenterOwner"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:domain="clr-namespace:QQLike.Domain"
        Loaded="UserContactGroupView_OnLoaded"
        Closed="UserContactGroupView_OnClosed"
        Height="560" Width="720">
    <Border Background="White" CornerRadius="7" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"></ColumnDefinition>
                <ColumnDefinition Width="0.5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource OutlineTextBox}" Height="36" Padding="5" Grid.Row="0"
                         materialDesign:HintAssist.Hint="搜索联系人"
                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchTextBox_OnTextChanged"
                         Margin="10">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchUsersCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox Grid.Row="1"  FontSize="15" Height="32" Padding="10,0,0,0"
                         BorderThickness="0,0,0,1"
                         BorderBrush="#1000">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreateGroupCommand}" Value="True">
                                    <Setter Property="Text" Value="选择好友创建" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsShareCommand}" Value="True">
                                    <Setter Property="Text" Value="选择联系人分享" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ListBox Grid.Row="2" ItemsSource="{Binding SearchResult}" Visibility="{Binding IsSearching,Converter={StaticResource BoolVisibilityConverter2}}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="6,4" Margin="0,2" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ChooseUserContactCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="0"
                                        Height="40"
                                        ToolTip="{Binding ContactToolTipText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                     Margin="10,0">
                                        </RadioButton>
                                        <!-- 头像 -->
                                        <Ellipse Grid.Column="1" Width="42" Height="42" Margin="4,0,12,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- 昵称 + 账号 -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ContactName}"
                                                       FontSize="12"
                                                       Foreground="#1E1E1E"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding AccountText}"
                                                       FontSize="12"
                                                       Foreground="#1E1E1E"
                                                       Margin="4,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TreeView Grid.Row="2" ItemsSource="{Binding UserContactGroups}"
                          x:Name="UserContactTreeView" Visibility="{Binding IsNotSearching, Converter={StaticResource BoolVisibilityConverter2}}">
                    <TreeView.Style>
                        <Style TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Style>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="20,0,0,0"
                                                            Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <!-- 联系人模板 -->
                        <DataTemplate DataType="{x:Type domain:UserContactGroupViewItem}">
                            <Border CornerRadius="6" Padding="6,4" Margin="0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ChooseUserContactCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="0"
                                        Height="40"
                                        ToolTip="{Binding ContactToolTipText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                     Margin="10,0">
                                        </RadioButton>
                                        <!-- 头像 -->
                                        <Ellipse Grid.Column="1" Width="42" Height="42" Margin="4,0,12,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- 昵称 + 账号 -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ContactName}"
                                                       FontSize="12"
                                                       Foreground="#1E1E1E"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding AccountText}"
                                                       FontSize="12"
                                                       Foreground="#1E1E1E"
                                                       Margin="4,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>

                        <!-- 分组模板 -->
                        <HierarchicalDataTemplate DataType="{x:Type domain:UserContactGroupItem}"
                                                  ItemsSource="{Binding UserContacts}">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="4,2"
                                    Height="36"
                                    Command="{Binding DataContext.UserGroupExpandCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                    CommandParameter="{Binding}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                                             RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <RotateTransform Angle="{Binding ExpandIconAngle}" />
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,4" />
                                    <Border Grid.Column="2" Background="#FFEDEDED" CornerRadius="10" Padding="8,2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserContactCount}" Foreground="#666" FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Button>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
            <Grid Grid.Column="1" Visibility="{Binding IsCreateGroupCommand,Converter={StaticResource BoolVisibilityConverter2}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ActionText}" Padding="5" Margin="10,10"></TextBlock>
                <ComboBox Grid.Row="1" SelectedItem="{Binding SelectedGroup}" ItemsSource="{Binding UserChatGroups}"
                         DisplayMemberPath="Label" SelectedValuePath="Value" Style="{StaticResource MaterialDesignComboBox}" Height="30"
                        BorderBrush="Transparent"  Width="300" HorizontalAlignment="Left" Margin="12,0,0,0"
                         materialDesign:HintAssist.Hint="选择分组"> </ComboBox>
                <ListBox Grid.Row="2" ItemsSource="{Binding SelectedUserContacts}" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                     <ListBox.ItemTemplate>
                         <DataTemplate>
                            <Border CornerRadius="6" Padding="4,2" Margin="0,1">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="Background" Value="Transparent" />
                                         <Style.Triggers>
                                             <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                             </Trigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Border.Style>
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>

                                     <!-- 头像 -->
                                     <Ellipse Width="36" Height="36" Margin="2,0,8,0" VerticalAlignment="Center">
                                         <Ellipse.Fill>
                                             <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                         </Ellipse.Fill>
                                     </Ellipse>

                                     <!-- 昵称 + 账号 -->
                                     <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                                         <TextBlock Text="{Binding ContactName}"
                                                    FontSize="12"
                                                    Foreground="#1E1E1E"
                                                    TextTrimming="CharacterEllipsis" />

                                     </Grid>
                                     <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                             Command="{Binding DataContext.RemoveSelectedUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}"
                                             Padding="2"
                                             MinWidth="0"
                                             Background="Transparent">
                                         <materialDesign:PackIcon Kind="CloseOutline" Height="20" Width="20" Padding="5"
                                                                  Foreground="#D9D9D9" />
                                     </Button>

                                 </Grid>
                             </Border>
                         </DataTemplate>
                     </ListBox.ItemTemplate>
                 </ListBox>
                 <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,10">
                     <Button 
                            materialDesign:ButtonAssist.CornerRadius="6" Foreground="#000" Background="#09f"
                            IsEnabled="{Binding IsConfirmEnabled}"
                            Command="{Binding ConfirmCommand}"
                            Content="确定">
                         <Button.Style>
                             <Style BasedOn="{StaticResource MaterialDesignOutlinedButton}" TargetType="Button">
                                 <Style.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                          <Setter Property="Foreground" Value="#000"></Setter>
                                      </Trigger>
                                 </Style.Triggers>
                             </Style>
                         </Button.Style>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10,0"
                            Command="{Binding CloseCommand}"
                            materialDesign:ButtonAssist.CornerRadius="6" Foreground="#000" Background="#fff"
                            Content="取消" BorderBrush="#000" BorderThickness="1">
                     </Button>
                 </StackPanel>
             </Grid>
         </Grid>
     </Border>
</Window>
<Window x:Class="QQLike.Components.ImagePreviewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:QQLike.Components"
        mc:Ignorable="d"
        Title="ImagePreviewer" Height="600" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="8" Background="#1E1E1E" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 标题栏 -->
                <RowDefinition Height="36"/>
                <!-- 图片显示区域 -->
                <RowDefinition Height="*"/>
                <!-- 底部工具栏 -->
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Border Grid.Row="0" Background="#2D2D2D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="图片预览" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#CCCCCC" FontSize="13"/>
                   <local:CommonToolHeader></local:CommonToolHeader>
                </Grid>
            </Border>

            <!-- ==================== 图片显示区域 ==================== -->
            <Grid Grid.Row="1" Background="#1E1E1E" ClipToBounds="True">
                <!-- 图片容器，支持缩放和平移 -->
                <Viewbox x:Name="ImageViewbox" Stretch="Uniform">
                    <Image x:Name="PreviewImage" Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Viewbox>
            </Grid>

            <!-- ==================== 底部工具栏 ==================== -->
            <Border Grid.Row="2" Background="#2D2D2D">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：缩放控制 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 缩小 -->
                        <Button x:Name="BtnZoomOut" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="缩小" Command="{Binding ZoomOutCommand}">
                            <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="20" Height="20"/>
                        </Button>
                        <!-- 缩放比例 -->
                        <TextBlock Text="{Binding ScaleText}" VerticalAlignment="Center"
                                   Foreground="#CCCCCC" FontSize="13" Margin="8,0"
                                   MinWidth="48" TextAlignment="Center"/>
                        <!-- 放大 -->
                        <Button x:Name="BtnZoomIn" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="放大" Command="{Binding ZoomInCommand}">
                            <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="20" Height="20"/>
                        </Button>
                        <!-- 分隔线 -->
                        <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>
                        <!-- 原始大小 1:1 -->
                        <Button x:Name="BtnActualSize" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="原始大小" Command="{Binding BackToActualSizeCommand}">
                            <materialDesign:PackIcon Kind="FitToScreenOutline" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：操作按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 旋转 -->
                        <Button x:Name="BtnRotate" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="旋转" Command="{Binding RotateCommand}">
                            <materialDesign:PackIcon Kind="RotateRight" Width="20" Height="20"/>
                        </Button>
                        <!-- 编辑 -->
                        <Button x:Name="BtnEdit" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="编辑" Command="{Binding EditCommand}">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20"/>
                        </Button>
                        <!-- 裁剪 -->
                        <Button x:Name="BtnCrop" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="裁剪" Command="{Binding CropCommand}">
                            <materialDesign:PackIcon Kind="Crop" Width="20" Height="20"/>
                        </Button>
                        <!-- 标注 -->
                        <Button x:Name="BtnAnnotate" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="标注" Command="{Binding AnnotateCommand}">
                            <materialDesign:PackIcon Kind="FormatText" Width="20" Height="20"/>
                        </Button>
                        <!-- 分隔线 -->
                        <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>
                        <!-- 分享 -->
                        <Button x:Name="BtnShare" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="分享" Command="{Binding ShareCommand}">
                            <materialDesign:PackIcon Kind="ShareVariantOutline" Width="20" Height="20"/>
                        </Button>
                        <!-- 下载/保存 -->
                        <Button x:Name="BtnSave" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="保存" Command="{Binding SaveCommand}">
                            <materialDesign:PackIcon Kind="DownloadOutline" Width="20" Height="20"/>
                        </Button>
                        <!-- 更多 -->
                        <Button x:Name="BtnMore" Width="36" Height="36"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#CCCCCC" ToolTip="更多" Command="{Binding MoreCommand}">
                            <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

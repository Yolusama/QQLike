<Window x:Class="QQLike.Components.ComprehensiveSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QQLike.Components"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="综合搜索" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="White" Padding="16,8"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="综合搜索" FontSize="13" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
               <local:CommonToolHeader></local:CommonToolHeader>
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     materialDesign:HintAssist.Hint="输入搜索关键词"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center"
                     Height="40"
                     Padding="12,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Content="搜索"
                    Width="80" Height="40"
                    Margin="12,0,0,0"
                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                    Background="#FF1E90FF"
                    Foreground="White"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    Command="{Binding SearchCommand}" />
        </Grid>
        <!-- Search Results List -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="16,0,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,10"
                                BorderBrush="#FFF0F0F0"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Ellipse Grid.Column="0"
                                         Width="48" Height="48"
                                         VerticalAlignment="Top"
                                         Margin="0,0,12,0"
                                         Stroke="#FFE0E0E0"
                                         StrokeThickness="1">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Avatar}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FF222222" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding MemberCount}"
                                                   FontSize="12"
                                                   Foreground="#FF999999" />
                                        <TextBlock Text="{Binding Tag1}"
                                                   FontSize="12"
                                                   Foreground="#FF999999"
                                                   Margin="8,0,0,0"
                                                   Background="#FFF5F5F5"
                                                   Padding="4,1" />
                                        <TextBlock Text="{Binding Tag2}"
                                                   FontSize="12"
                                                   Foreground="#FF999999"
                                                   Margin="8,0,0,0"
                                                   Background="#FFF5F5F5"
                                                   Padding="4,1" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13"
                                               Foreground="#FF888888"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               MaxWidth="500"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Join Button -->
                                <Button Grid.Column="2"
                                        Content="加入"
                                        Width="72" Height="32"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="16"
                                        FontSize="13"
                                        Command="{Binding JoinCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

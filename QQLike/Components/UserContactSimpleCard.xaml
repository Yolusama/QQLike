<UserControl x:Class="QQLike.Components.UserContactSimpleCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        IsVisibleChanged="UserContactSimpleCard_OnIsVisibleChanged"
        xmlns:behaviors="clr-namespace:QQLike.Behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Height="320" Width="360">
    <Border Background="White" CornerRadius="12"  BorderBrush="#E8E8E8" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: Avatar + Nickname + QQ + Online Status -->
            <Grid Grid.Row="0" Margin="0,0,0,20" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Background="#F5F7FB" Margin="0,0,0,0" Height="100"
                             HorizontalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2">
                    <Ellipse Width="60" Height="60"  behaviors:ImagePreview.Previewable="True" Margin="22,0,0,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Nickname}" FontSize="15" />
                            <materialDesign:PackIcon Foreground="#2196f2" Kind="GenderMale" VerticalAlignment="Center" Height="20" Width="20"
                                                     Visibility="{Binding IsMale, Converter={StaticResource BoolVisibilityConverter2}}" />
                            <materialDesign:PackIcon Foreground="DeepPink" Kind="GenderFemale" VerticalAlignment="Center" Height="20" Width="20"
                                                     Visibility="{Binding IsFemale, Converter={StaticResource BoolVisibilityConverter2}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Account}" FontSize="13" Foreground="#7D7D7E" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="12" Height="12" Fill="#2ED573" VerticalAlignment="Center"  Visibility="{Binding IsOnline, Converter={StaticResource BoolVisibilityConverter2}}" />
                            <Ellipse Width="12" Height="12" Fill="#BDBDCB" VerticalAlignment="Center"  Visibility="{Binding IsOffline, Converter={StaticResource BoolVisibilityConverter2}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Info Rows: Remark, Location, Birthday -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsUserView, Converter={StaticResource BoolVisibilityConverter2}}">
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="备注" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding Remark}" FontSize="15" TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="20,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="签名" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding Signature}" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Margin="20,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="所在地" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding Region}" FontSize="15" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="20,18,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="生日" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding BirthdayText}" FontSize="15" />
                </Grid>
            </StackPanel>

            <!-- Bottom Buttons: Share + Send Message -->
            <UniformGrid Grid.Row="2"  HorizontalAlignment="Center"  Columns="2">
                <Button Content="分享" Height="36" Background="White"
                        Margin="0,0,12,0" Command="{Binding ShareCommand}"
                        Width="80" Foreground="#333" BorderBrush="#DDD" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="发消息" Height="36" Background="#2196F3"
                        Command="{Binding OpenMessagingCommand}"
                        Width="100" Foreground="White" BorderBrush="#2196F3" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>

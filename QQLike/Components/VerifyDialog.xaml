<Window x:Class="QQLike.Components.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:QQLike.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Loaded="VerifyDialog_OnLoadedLoaded"
        Title="申请加好友">
    <materialDesign:Card
        Padding="16"
        UniformCornerRadius="8"
        Width="420">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding CloseCommand}">
                <materialDesign:PackIcon Kind="Close" Height="16" Width="16"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top" ></materialDesign:PackIcon>
            </Button>
        
            <!-- Title Bar -->
            <materialDesign:ColorZone
                Grid.Row="0"
                Mode="PrimaryLight"
                Padding="16,12">
                <Grid>
                    <TextBlock
                        Text="申请加好友"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <Button
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="36" Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="关闭">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Content -->
                <StackPanel>
                    <!-- User Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse Width="56" Height="56" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nickname}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Account}" FontSize="13" Foreground="#999" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 填写验证信息 -->
                    <TextBlock Text="填写验证信息" FontSize="13" Foreground="#999" Margin="0,0,0,8"/>
                    <TextBox
                        Text="{Binding VerifyMessage, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        materialDesign:HintAssist.Hint="请输入验证信息"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="60"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,16"/>

                    <!-- 备注 -->
                    <TextBlock Text="备注" FontSize="13" Foreground="#999" Margin="0,0,0,8"/>
                    <TextBox
                        Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        materialDesign:HintAssist.Hint="请输入备注"
                        MinHeight="60"
                        Margin="0,0,0,16"/>

                    <!-- 分组 -->
                    <TextBlock Text="分组" FontSize="13" Foreground="#999" Margin="0,0,0,8"/>
                    <ComboBox
                        ItemsSource="{Binding Groups}"
                        IsEditable="True"
                        SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}"
                        DisplayMemberPath="Name"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="0,0,0,16"/>
                </StackPanel>

            <!-- Action Buttons -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="16,8,16,16">
                <Button
                    Content="发送"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Background="#2196F3"
                    materialDesign:ButtonAssist.CornerRadius="4"/>
                <Button
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="100"
                    materialDesign:ButtonAssist.CornerRadius="4"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>

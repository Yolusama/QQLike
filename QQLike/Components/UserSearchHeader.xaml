<UserControl x:Class="QQLike.Components.UserSearchHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QQLike.Components"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Background="#f5f5f5">
        <Grid Margin="6" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*" />
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBox Grid.Column="0"
                     Height="40"
                     Text="{Binding SearchText}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Padding="10"
                     LostFocus="TextBox_LostFocus"
                     TextChanged="TextBox_TextChanged"
                     materialDesign:HintAssist.Hint="搜索"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

            <Button Grid.Row="0" Grid.Column="1"
                    Width="40"
                    Height="40"
                    Margin="8,0,0,0"
                    Background="#ebebeb"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <materialDesign:PackIcon Kind="Plus" Width="36" Height="36" />
            </Button>
            <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="#fff" CornerRadius="4"
                    Margin="12,10,0,0"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolVisibilityConverter2}}">
                <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#000">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="AccountOutline" VerticalAlignment="Center"></materialDesign:PackIcon>
                            <Label Content="加好友/群" VerticalAlignment="Center" FontSize="12"></Label>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#000">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="AccountGroupOutline" VerticalAlignment="Center"></materialDesign:PackIcon>
                            <Label Content="创建群聊" VerticalAlignment="Center" FontSize="12"></Label>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Padding="4" Margin="0,10,0,0" BorderThickness="1"
                    BorderBrush="#fff" CornerRadius="4"
                    Visibility="{Binding IsSearching,
              Converter={StaticResource BoolVisibilityConverter2}}">
                <ScrollViewer
                    MaxHeight="400"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <TextBlock Text="联系人" Foreground="Gray"></TextBlock>
                            <ListBox ItemsSource="{Binding UserResults}" Height="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding GoUserMessageCommand}">
                                            <StackPanel Orientation="Vertical" Margin="4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                                    <Image Width="30" Height="30" Source="{Binding Avatar}"
                                                           Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding ContactName}" VerticalAlignment="Center" />
                                                    <Button HorizontalAlignment="Right"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Command="{Binding GoUserMessageCommand}">
                                                        <materialDesign:PackIcon Kind="User"></materialDesign:PackIcon>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding GroupFrom}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="群聊" Foreground="Gray"></TextBlock>
                            <ListBox ItemsSource="{Binding GroupResults}" Height="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding GoGroupMessageCommand}">
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <StackPanel Orientation="Vertical" Margin="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="30" Height="30" Source="{Binding Avatar}"
                                                               Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ContactName}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding GoGroupProfileCommand}">
                                                            <materialDesign:PackIcon Kind="AccountGroup"></materialDesign:PackIcon>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GroupFrom}" FontSize="10"
                                                               Foreground="Gray" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="QQLike.Components.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Loaded="UserCard_OnLoaded"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="450">
    <Border Background="White" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="88" Height="88" VerticalAlignment="Top">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Nickname}" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GenderSymbol}" FontSize="22" Foreground="#2196F3" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Account}" FontSize="15" Foreground="#777" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="12" Height="12" Fill="#2ED573" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OnlineStatus}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="签名" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding Signature}" FontSize="15" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,8,0,0" Visibility="{Binding ShowBirthday, Converter={StaticResource BoolVisibilityConverter2}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="生日" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding BirthdayText}" FontSize="15" />
                </Grid>

                <Grid Margin="0,8,0,0" Visibility="{Binding ShowLocation, Converter={StaticResource BoolVisibilityConverter2}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="所在地" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding LocationText}" FontSize="15" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,8,0,0" Visibility="{Binding ShowGroupNickname, Converter={StaticResource BoolVisibilityConverter2}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="群昵称" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding GroupNickname}" FontSize="15" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,8,0,0" Visibility="{Binding ShowGroupRole, Converter={StaticResource BoolVisibilityConverter2}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="群组" Foreground="#667085" FontSize="15" />
                    <TextBlock Grid.Column="1" Text="{Binding GroupRoleText}" FontSize="15" />
                </Grid>
            </StackPanel>

            <UniformGrid Grid.Row="2"  Margin="20" HorizontalAlignment="Center">
                <Button Content="加好友" Height="44" Background="#2196F3" 
                        Margin="0,0,12,0" Command="{Binding AddFriendCommand}"
                    Width="100"    Foreground="White" BorderBrush="#2196F3" Visibility="{Binding IsFriend, Converter={StaticResource InverseBoolVisibilityConverter}}">
                </Button>
                <Button Content="发消息" Height="44" Background="#2196F3" Visibility="{Binding IsNotFriend, Converter={StaticResource BoolVisibilityConverter2}}"
                        Foreground="White" BorderBrush="#2196F3" />
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>

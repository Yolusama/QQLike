<UserControl x:Class="QQLike.Views.User.UserContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:entity="clr-namespace:QQLike.Entity;assembly=Entity"
             xmlns:domain="clr-namespace:QQLike.Domain"
             xmlns:vo="clr-namespace:QQLike.Entity.VO;assembly=Entity"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             d:DesignHeight="700" d:DesignWidth="300">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="12,14,12,0">
            <Button Height="44"
                    Margin="0,0,0,12"
                    Command="{Binding OpenUserContactManageCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCog" Width="20" Height="20" Margin="0,0,6,0" />
                    <TextBlock Text="好友管理器" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

       
            <Border Background="#FFF2F2F2" CornerRadius="8" Padding="4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" HorizontalAlignment="Stretch" CornerRadius="6" Margin="0,0,4,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding SwitchUserView}">
                            <TextBlock Text="好友" Foreground="#2196F3" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"  />
                        </Button>
                    </Border>

                    <Border Grid.Column="1" Background="Transparent" CornerRadius="6" Margin="4,0,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding SwitchGroupView}">
                            <TextBlock Text="群聊" Foreground="#666" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"  />
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <TreeView ItemsSource="{Binding UserContactGroups}"
                      x:Name="UserContactTreeView">
                <TreeView.Style>
                    <Style TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.Style>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <EventSetter Event="Expanded" Handler="OnTreeViewItemExpanded" />
                        <EventSetter Event="Collapsed" Handler="OnTreeViewItemCollapsed" />
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <!-- 联系人模板 -->
                    <DataTemplate DataType="{x:Type vo:UserContactInfo}">
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="4,0,8,0" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15">
                                <Run Text="{Binding Nickname, TargetNullValue=''}" />
                                <Run Text="{Binding ContactId}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>

                    <!-- 分组模板 -->
                    <HierarchicalDataTemplate DataType="{x:Type domain:UserContactGroupItem}"
                                              ItemsSource="{Binding UserContacts}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform Angle="{Binding ExpandIconAngle}" />
                                </materialDesign:PackIcon.RenderTransform>
                            </materialDesign:PackIcon>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,4" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
            
        </Grid>
    </Grid>
</UserControl>
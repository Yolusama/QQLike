<UserControl x:Class="QQLike.Views.Message.VerificationMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QQLike.Views.Message"
        xmlns:components="clr-namespace:QQLike.Components"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="VerifySwitchButtonBase" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCDCE2"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Background" Value="#F4F5F8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:CommonToolHeader Grid.Row="0"/>
        <TextBlock Grid.Row="1"
                   Margin="18,4,0,10"
                   Text="{Binding NotificationTitle}"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#1E1E1E"/>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal"
                    Margin="0,12,0,8">
            <Button Content="好友验证" Command="{Binding ToVerifyFriendsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VerifySwitchButtonBase}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupVerify}" Value="False">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#3F51B5"/>
                                <Setter Property="BorderBrush" Value="#3F51B5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="群聊验证" Command="{Binding ToVerifyGroupsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VerifySwitchButtonBase}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupVerify}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#3F51B5"/>
                                <Setter Property="BorderBrush" Value="#3F51B5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
            <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10,8"
                                Padding="16,14"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#EBECF0"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="58" Height="58" Margin="4,0,14,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserName}"
                                                   Foreground="#2D7CFF"
                                                   FontWeight="SemiBold"
                                                   FontSize="20"/>
                                        <TextBlock Text=" " FontSize="20"/>
                                        <TextBlock Text="{Binding ActionText}" FontSize="18" Foreground="#1F1F1F"/>
                                        <TextBlock Text=" " FontSize="20"/>
                                        <TextBlock Text="{Binding DateText}" FontSize="18" Foreground="#8A8A8A"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceText}" FontSize="16" Foreground="#8A8A8A" Margin="0,6,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusText}"
                                           Foreground="#8A8A8A"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

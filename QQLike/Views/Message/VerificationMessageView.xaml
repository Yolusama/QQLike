<UserControl x:Class="QQLike.Views.Message.VerificationMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QQLike.Views.Message"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        x:Name="Root"
        IsVisibleChanged="VerificationMessageView_OnIsVisibleChanged"
        mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="VerifySwitchButtonBase" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCDCE2"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Background" Value="#F4F5F8"/>
        </Style>

        <Style x:Key="SplitAcceptButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="#3F51B5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SplitRejectButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

       
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsAcceptDialogOpen}" DialogTheme="Inherit">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="24" Width="380">
                <TextBlock Text="同意验证请求" FontSize="18" FontWeight="Bold" 
                           Foreground="#1E1E1E" Margin="0,0,0,20"/>

                <TextBlock Text="选择分组" FontSize="13" 
                           Foreground="#666" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding AcceptableGroups}"
                          SelectedValue="{Binding SelectedGroupId, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          materialDesign:HintAssist.Hint="请选择分组"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,16"/>

                <TextBlock Text="设置备注" FontSize="13" 
                           Foreground="#666" Margin="0,0,0,6"/>
                <TextBox Text="{Binding AcceptRemark, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="备注（可选）"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,20"/>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="取消"
                            Command="{Binding CancelAcceptDialogCommand}"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,12,0"/>
                    <Button Content="确定"
                            Command="{Binding ConfirmAcceptVerifyCommand}"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#3F51B5"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid Background="#F5F5F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="1"
                   Margin="18,4,0,10"
                   Text="{Binding NotificationTitle}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1E1E1E"/>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal"
                    Margin="0,12,0,8">
                <Button Content="好友验证" Command="{Binding ToVerifyFriendsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VerifySwitchButtonBase}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupVerify}" Value="False">
                                    <Setter Property="Foreground" Value="#000"/>
                                    <Setter Property="Background" Value="#3F51B5"/>
                                    <Setter Property="BorderBrush" Value="#3F51B5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="群聊验证" Command="{Binding ToVerifyGroupsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VerifySwitchButtonBase}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupVerify}" Value="True">
                                    <Setter Property="Foreground" Value="#000"/>
                                    <Setter Property="Background" Value="#3F51B5"/>
                                    <Setter Property="BorderBrush" Value="#3F51B5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Notices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10,8"
                                    Padding="16,14"
                                    Background="White"
                                    CornerRadius="12"
                                    BorderBrush="#EBECF0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="58" Height="58" Margin="4,0,14,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource TextButtonStyle}"
                                                    Command="{Binding DataContext.GoUserMessageCommand}">
                                                <TextBlock Text="{Binding Nickname}"
                                                       Foreground="#2D7CFF"
                                                       FontSize="14"/>
                                            </Button>
                                            <TextBlock Text=" " FontSize="20"/>
                                            <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="#8A8A8A"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source}" FontSize="14" Foreground="#8A8A8A" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding VerificationMessage}" FontSize="14" Foreground="#8A8A8A" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- 状态区域：Status==0 显示拆分按钮，否则显示状态文本 -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0">
                                        <!-- Status != 0：状态文本 -->
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="#8A8A8A"
                                                   FontSize="14"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Status == 0：拆分按钮（主按钮"同意" + 下拉"忽略"/"拒绝"） -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border BorderBrush="#DCDCE2" BorderThickness="1" CornerRadius="4"
                                                    Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Button Grid.Column="0" Content="同意"
                                                            Width="60"
                                                            Style="{StaticResource SplitAcceptButtonStyle}"
                                                            Command="{Binding DataContext.AcceptVerifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    
                                                    <Border Grid.Column="1" Background="#DCDCE2"/>
                                                    
                                                    <ToggleButton Grid.Column="2" x:Name="MoreToggle"
                                                              Content="▼"
                                                              Style="{StaticResource MaterialDesignFlatButton}"
                                                              Padding="6,4" FontSize="10"
                                                              Foreground="#666"
                                                              IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                                                              BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                            
                                            <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=MoreToggle}"
                                                   Placement="Bottom"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Background="White"
                                                        BorderBrush="#DCDCE2" BorderThickness="1"
                                                        CornerRadius="4" Padding="4"
                                                        Margin="0,2,0,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <Button Content="忽略"
                                                                    Width="60"
                                                                    Style="{StaticResource SplitRejectButtonStyle}"
                                                                    Padding="14,8"
                                                                    Command="{Binding DataContext.IgnoreVerifyCommand, Source={x:Reference Root}}"
                                                                    CommandParameter="{Binding}"/>
                                                        <Button Content="拒绝"
                                                                    Width="60"
                                                                    Style="{StaticResource SplitRejectButtonStyle}"
                                                                    Padding="14,8"
                                                                    Command="{Binding DataContext.RejectVerifyCommand, Source={x:Reference Root}}"
                                                                    CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>

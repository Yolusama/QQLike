<UserControl x:Class="QQLike.Views.Message.ChatMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:QQLike.Components"
             xmlns:views="clr-namespace:QQLike.Views.Message"
             xmlns:templates="clr-namespace:QQLike.Views.Templates"
             mc:Ignorable="d"
             IsVisibleChanged="ChatMessageView_OnIsVisibleChanged"
             d:DesignHeight="720" d:DesignWidth="1120">
    <UserControl.Resources>
        <Style x:Key="ConversationListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="82" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 选中指示条 -->
                            <Border x:Name="Indicator"
                                    Grid.Column="0"
                                    Background="#2196F3"
                                    Visibility="Collapsed" />

                            <Border x:Name="ItemBorder" Grid.Column="1" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FE" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F6F8" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatMessageItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 左侧头像（对方消息时显示） -->
                <Border x:Name="LeftAvatar"
                       
                        Width="38"
                        Height="38"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Visibility="{Binding LeftAvatarVisibility}">
                    <Ellipse Width="30" Height="30">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>

                <!-- 气泡+时间组合容器：容器拉伸铺满中间列，时间可稳定居中 -->
                <Grid x:Name="MessageBody" Grid.Column="1"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 昵称和时间同一行（时间保持整行居中） -->
                    <Grid Grid.Row="0" Margin="0,0,0,4"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12"
                                   Foreground="#8F8F8F"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding ContactNameVisibility}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter Property="Grid.Column" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding MessageTimeText}"
                                   FontSize="11"
                                   Foreground="#A9A9A9"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    HorizontalAlignment="{Binding BubbleHorizontalAlignment}"
                                    ContentTemplateSelector="{DynamicResource ChatMessageBodyTemplateSelector}" />
                </Grid>

                <!-- 右侧头像（自己消息时显示） -->
                <Border x:Name="RightAvatar"
                        Grid.Column="2"
                        Width="38"
                        Height="38"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Visibility="{Binding RightAvatarVisibility}">
                    <Ellipse Width="30" Height="30">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextMessageBodyTemplate">
            <Border MaxWidth="460"
                    Padding="12,8"
                    CornerRadius="8"
                    HorizontalAlignment="{Binding BubbleHorizontalAlignment}"
                    Background="{Binding BubbleBackground}"
                    BorderBrush="{Binding BubbleBorderBrush}"
                    VerticalAlignment="Center"
                   >
                <TextBlock Text="{Binding Content}"
                           FontSize="14"
                           Foreground="#1F1F1F"
                           TextWrapping="WrapWithOverflow" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImageMessageBodyTemplate">
            <Border MaxWidth="260" MaxHeight="320" CornerRadius="8" ClipToBounds="True"
                    Background="{Binding BubbleBackground}"
                    BorderBrush="{Binding BubbleBorderBrush}"
                    BorderThickness="1">
                <Image Source="{Binding MediaUrl}"
                       Stretch="Uniform"
                       MaxWidth="260"
                       MaxHeight="320" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AudioMessageBodyTemplate">
            <Border MaxWidth="320" MinWidth="220" Padding="12,8" CornerRadius="8"
                    Background="{Binding BubbleBackground}"
                    BorderBrush="{Binding BubbleBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="PlayToggle"
                                  Width="36" Height="36" Padding="8"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Foreground="#2196F3"
                                  Click="ToggleMediaPlay"
                                  ToolTip="播放/暂停">
                        <materialDesign:PackIcon x:Name="PlayIcon" Kind="Play" Width="20" Height="20" />
                    </ToggleButton>
                    <MediaElement Grid.Column="1"
                                  x:Name="AudioMedia"
                                  Width="0" Height="0"
                                  Source="{Binding MediaUrl}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Volume="1" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VideoMessageBodyTemplate">
            <Border MaxWidth="360" CornerRadius="8" ClipToBounds="True"
                    Background="#1F1F1F"
                    BorderBrush="{Binding BubbleBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <MediaElement x:Name="VideoMedia"
                                  Width="360" Height="240"
                                  Source="{Binding MediaUrl}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform" />
                    <ToggleButton x:Name="PlayToggle"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="48" Height="48" Padding="8"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Foreground="White"
                                  Click="ToggleMediaPlay"
                                  ToolTip="播放/暂停">
                        <materialDesign:PackIcon x:Name="PlayIcon" Kind="Play" Width="28" Height="28" />
                    </ToggleButton>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileMessageBodyTemplate">
            <Border MaxWidth="320" MinWidth="220" Padding="12,10" CornerRadius="8"
                    Background="{Binding BubbleBackground}"
                    BorderBrush="{Binding BubbleBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="FileOutline" Width="44" Height="44" Foreground="#2196F3"
                                             VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="14" Foreground="#1F1F1F"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="文件" FontSize="12" Foreground="#A9A9A9" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <templates:ChatMessageBodyTemplateSelector x:Key="ChatMessageBodyTemplateSelector"
                                                   TextTemplate="{StaticResource TextMessageBodyTemplate}"
                                                   ImageTemplate="{StaticResource ImageMessageBodyTemplate}"
                                                   AudioTemplate="{StaticResource AudioMessageBodyTemplate}"
                                                   VideoTemplate="{StaticResource VideoMessageBodyTemplate}"
                                                   FileTemplate="{StaticResource FileMessageBodyTemplate}" />


    </UserControl.Resources>

    <Grid Background="#F6F7FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding HeadMessages}"
                     SelectedItem="{Binding SelectedHeadMessage, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ConversationItemStyle}"
                     Style="{StaticResource ConversationListBoxStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.CheckMessagesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding }"
                            Style="{StaticResource TextButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 头像（无头像时显示首字母占位） -->
                                <Border Width="40" Height="40" CornerRadius="20" Background="#E9EEF4"
                                        Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="#7D7D7D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- 文本区：名字/时间 + 内容/未读 -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#1F1F1F" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#A5A5A5"
                                                   FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LastContent}" FontSize="12" Foreground="#8F8F8F"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F44336" CornerRadius="10" Padding="5,1"
                                                MinWidth="20" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Text="{Binding UnreadCount, Converter={StaticResource UnreadCountToTextConverter}}"
                                                Foreground="White" FontSize="11" TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Column="1" Background="#FAFAFA">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25"
                        Visibility="{Binding IsNoSelection, Converter={StaticResource BoolVisibilityConverter2}}">
                <materialDesign:PackIcon Kind="AccountCircleOutline" Width="170" Height="170" Foreground="#C7C7C7"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="选择一个会话查看详情" Margin="0,12,0,0" FontSize="20" Foreground="#A7A7A7"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibilityConverter2}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="5,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"  VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Cursor="Hand"
                                    x:Name="DisplayNameButton" Command="{Binding OpenUserCardPopupCommand}">
                                <TextBlock Text="{Binding SelectedHeadMessage.DisplayName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F1F1F"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Popup PlacementTarget="{Binding ElementName=DisplayNameButton}" Placement="Bottom" Margin="0,20,0,0"
                       IsOpen="{Binding IsUserCardPopupOpen}" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <components:UserContactSimpleCard x:Name="UserContactSimpleCard" Visibility="{Binding Visible}">
                    </components:UserContactSimpleCard>
                </Popup>

                <components:InfinityScrollView
                    Grid.Row="1"
                    LoadMoreCommand="{Binding ScrollToTopCommand}" Direction="Up"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <ListBox ItemsSource="{Binding ChatMessages}"
                             ItemContainerStyle="{StaticResource ChatMessageItemStyle}"
                             ItemTemplate="{StaticResource ChatMessageTemplate}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </components:InfinityScrollView>

                <Border Grid.Row="2" Background="White" BorderBrush="#E6E6E6" BorderThickness="1,1,0,0" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Button Width="32" Height="32" Margin="4,0,0,0" Padding="5"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#757575" ToolTip="截图">
                                    <materialDesign:PackIcon Kind="ContentCut" Width="20" Height="20" />
                                </Button>
                                <Button Width="32" Height="32" Margin="4,0,0,0" Padding="5"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#757575" ToolTip="打开文件">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="20" Height="20" />
                                </Button>
                                <Button Width="32" Height="32" Margin="4,0,0,0" Padding="5"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#757575" ToolTip="图片">
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="20" Height="20" />
                                </Button>
                                <Button Width="32" Height="32" Margin="4,0,0,0" Padding="5"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#757575" ToolTip="视频">
                                    <materialDesign:PackIcon Kind="VideoOutline" Width="20" Height="20" />
                                </Button>
                                <Button Width="32" Height="32" Margin="4,0,0,0" Padding="5"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#757575" ToolTip="语音">
                                    <materialDesign:PackIcon Kind="MicrophoneOutline" Width="20" Height="20" />
                                </Button>
                            </StackPanel>

                            <Button Grid.Column="1" Width="32" Height="32" Padding="5"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#757575" ToolTip="历史记录">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" />
                            </Button>
                        </Grid>

                        <!-- Text Input Area -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding NewMessageText}"
                                 MinHeight="100"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 x:Name="ContentWriteTo"
                                 FontSize="14"
                                 Padding="4" />

                        <!-- Send Button Row -->
                        <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Border Background="#2196F3" CornerRadius="6" Padding="16,6">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontSize="14"
                                        Content="发送"
                                        ToolTip="发送消息 (Enter)"
                                        Command="{Binding SendMessageCommand}"
                                        Padding="8,2" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
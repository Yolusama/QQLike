<Window x:Class="QQLike.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:QQLike.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:QQLike.Components"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Title="RegisterView" Height="600" Width="500"
        Background="#f2f2f2FF">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="RegTextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Margin" Value="0,10,0,10" />
            <Setter Property="Height" Value="36" />
        </Style>
        <Style TargetType="PasswordBox" x:Key="RegPasswordBox"
               BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
            <Setter Property="Height" Value="36" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BgStop1" Color="#FFEAF6FF" Offset="0.00" />
                <GradientStop x:Name="BgStop2" Color="#FFD9EEFF" Offset="0.45" />
                <GradientStop x:Name="BgStop3" Color="#FFF7ECFF" Offset="1.00" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="BgStop1"
                                         Storyboard.TargetProperty="Offset"
                                         From="-0.2"
                                         To="0.2"
                                         Duration="0:0:4" />
                        <DoubleAnimation Storyboard.TargetName="BgStop2"
                                         Storyboard.TargetProperty="Offset"
                                         From="0.35"
                                         To="0.7"
                                         Duration="0:0:6" />
                        <DoubleAnimation Storyboard.TargetName="BgStop3"
                                         Storyboard.TargetProperty="Offset"
                                         From="0.8"
                                         To="1.2"
                                         Duration="0:0:5" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0.2*" />
        </Grid.RowDefinitions>
        <components:EntryHeader MinimizeButtonVisible="True" VerticalAlignment="Top"></components:EntryHeader>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250"
                    Orientation="Vertical">
            <Label Content="欢迎注册" VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="20" FontWeight="Bold" />
            <TextBox
                Style="{StaticResource RegTextBox}"
                materialDesign:HintAssist.Hint="昵称"
                Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" />


            <PasswordBox
                x:Name="PasswordBox"
                Style="{StaticResource RegPasswordBox}"
                GotFocus="PasswordBox_GotFocus"
                LostFocus="PasswordBox_LostFocus"
                PasswordChanged="PasswordBox_PasswordChanged"
                materialDesign:HintAssist.Hint="输入密码" />

            <StackPanel Orientation="Vertical" Margin="0,0,0,2" 
                        x:Name="PasswordRequirementsPanel"
                        Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <materialDesign:PackIcon x:Name="NoSpaceIcon" Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#F44336"
                                             Margin="0,2,6,0" />
                    <TextBlock Text="不能包括空格" Foreground="#8B95A5" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <materialDesign:PackIcon x:Name="LengthIcon" Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#F44336"
                                             Margin="0,2,6,0" />
                    <TextBlock Text="长度为8-16个字符" Foreground="#8B95A5" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <materialDesign:PackIcon x:Name="CategoryIcon" Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#F44336"
                                             Margin="0,2,6,0" />
                    <TextBlock Text="必须包含字母、数字、符号中至少2种" Foreground="#8B95A5" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <materialDesign:PackIcon x:Name="SequenceIcon" Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#F44336"
                                             Margin="0,2,6,0" />
                    <TextBlock Text="请勿输入连续、重复6位以上字母或数字，如" Foreground="#8B95A5" FontSize="13" TextWrapping="Wrap"
                               Width="228" />
                </StackPanel>
                <TextBlock Text="abcdefg、1111111、0123456" Foreground="#8B95A5" FontSize="13" Margin="22,0,0,0" />
            </StackPanel>
            <TextBox Style="{StaticResource RegTextBox}"
                materialDesign:HintAssist.Hint="电子邮箱"
            >
                <TextBox.Text>
                    <Binding Path="Email">
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource RegTextBox}"
                         materialDesign:HintAssist.Hint="验证码"
                         Width="130"
                         HorizontalAlignment="Left"
                         Margin="0,10,10,10"
                >
                    <TextBox.Text>
                        <Binding Path="VerificationCode">
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <Button
                    Width="100"
                    HorizontalAlignment="Right"
                    Content="{Binding VerifyButtonContent}"
                    Command="{Binding GetVerificationCodeCommand}"
                    IsEnabled="{Binding VerifyEnabled}"
                    Style="{StaticResource MaterialDesignPaperDarkButton}"
                />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="注册" Width="105" Height="36" Margin="0,10,10,10"
                        Command="{Binding RegisterCommand}" Background="#0099ff"  />
                <Button Content="返回登录" Width="105" Height="36"
                        Command="{Binding ReturnToLoginCommand}" Background="DarkGray" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>